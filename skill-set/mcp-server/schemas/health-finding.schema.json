{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-lab.local/schemas/health-finding.json",
  "title": "HealthFinding",
  "type": "object",
  "required": ["id", "severity", "category", "message", "sourcePath"],
  "properties": {
    "id": { "type": "string" },
    "severity": { "enum": ["info", "warning", "error"] },
    "category": { "type": "string" },
    "message": { "type": "string" },
    "sourcePath": { "type": "string" },
    "recommendation": { "type": "string" },
    "environmentId": { "type": "string" },
    "skillName": { "type": "string" },
    "primaryAction": { "enum": ["manual", "agent", "none"] },
    "agentKind": {
      "enum": [
        "improve-skill",
        "create-escalation",
        "validate-skill",
        "suggest-relationships",
        "analyze-trigger-conflicts",
        "skill-patch"
      ]
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-lab.local/schemas/skill-graph-node.json",
  "title": "SkillGraphNode",
  "type": "object",
  "required": ["id", "type", "label"],
  "properties": {
    "id": { "type": "string" },
    "type": {
      "enum": [
        "skill",
        "mcp_tool",
        "environment",
        "workflow",
        "reference",
        "script"
      ]
    },
    "label": { "type": "string" },
    "scope": { "type": "string" },
    "environmentId": { "type": "string" },
    "project": { "type": "string" },
    "sourcePath": { "type": "string" },
    "health": {
      "type": "object",
      "required": ["status", "findings"],
      "properties": {
        "status": { "enum": ["ok", "warning", "error"] },
        "findings": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "additionalProperties": false
}

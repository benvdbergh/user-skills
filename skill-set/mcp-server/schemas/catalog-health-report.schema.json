{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-lab.local/schemas/catalog-health-report.json",
  "title": "CatalogHealthReport",
  "type": "object",
  "required": ["findings", "scannedAt", "durationMs", "summary"],
  "properties": {
    "findings": {
      "type": "array",
      "items": { "$ref": "health-finding.schema.json" }
    },
    "scannedAt": { "type": "string", "format": "date-time" },
    "durationMs": { "type": "number", "minimum": 0 },
    "summary": {
      "type": "object",
      "required": ["info", "warning", "error", "total"],
      "properties": {
        "info": { "type": "integer", "minimum": 0 },
        "warning": { "type": "integer", "minimum": 0 },
        "error": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
